DATABASE_URL=postgresql://user:password@localhost:5432/youthpass
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# dev|production — refresh_token 쿠키의 Secure/SameSite 속성을 분기 (로컬 HTTP 개발은 dev)
ENV=production
YOUTH_API_KEY=your-youth-center-api-key
YOUTH_API_BASE_URL=https://www.youthcenter.go.kr/go/ythip/getPlcy
# 신청 URL 없는 정책의 폴백 상세 페이지 (기본값 있음, 미설정 가능)
YTH_DETAIL_URL_BASE=https://www.youthcenter.go.kr/youthPolicy/ythPlcyTotalSearch/ythPlcyDetail

# Google OAuth (Google Cloud Console에서 발급)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# 프론트엔드(Next.js) origin을 거치는 경로로 등록 — Next.js rewrites(next.config.ts)가
# 이 경로를 백엔드로 프록시하므로, 브라우저 입장에서는 항상 프론트엔드 origin과만 통신하게 되어
# refresh_token 쿠키가 first-party로 유지됨 (모바일 Safari ITP 등 서드파티 쿠키 차단 회피).
# 백엔드 자체 도메인(backend-railway-url)을 직접 등록하지 않도록 주의.
# 로컬: http://localhost:3000/api/auth/get/google-callback
# 배포: https://<frontend-railway-url>/api/auth/get/google-callback
# ⚠ 이 값과 동일한 URI를 Google Cloud Console > OAuth 클라이언트 > 승인된 리디렉션 URI에도 등록해야 함
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/get/google-callback

# Redis (Railway Redis 서비스의 REDIS_URL 참조 주입. 빈값/미설정이면 캐시 비활성)
REDIS_URL=redis://default:password@host:6379

# Elasticsearch (미설정이면 검색이 PostgreSQL 경로로 동작 — 로컬 기본)
ELASTICSEARCH_URL=

# CORS 허용 출처 (쉼표 구분)
# 로컬에서 https://localhost:3000으로 접속하는 경우 해당 출처도 함께 추가한다.
ALLOWED_ORIGINS=http://localhost:3000

# OAuth 콜백 후 리다이렉트할 프론트엔드 URL (단일 값)
# 로컬: http://localhost:3000 (https 접속 시 https://localhost:3000)
# 배포: https://<frontend-railway-url>
FRONTEND_URL=http://localhost:3000

# Cloudflare R2 (프로필 이미지 저장 — 대시보드에서 버킷/API 토큰 발급 필요)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=youthpass-profile-images
# 버킷에 연결한 퍼블릭 커스텀 도메인 (또는 r2.dev 퍼블릭 URL)
R2_PUBLIC_BASE_URL=https://images.youthpass.app
